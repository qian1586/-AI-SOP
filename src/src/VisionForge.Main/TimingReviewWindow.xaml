<Window x:Class="VisionForge.Main.TimingReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="动作时间回看"
        Height="900" Width="1200"
        MinHeight="640" MinWidth="900"
        Background="{StaticResource BgWindow}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!--
        动作时间回看：查询 + 趋势图 + 工序耗时排行（柏拉图）+ 明细表。
        数据来自 data\timings\*.jsonl，随做随记，这里只是"看"。
    -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="动作时间回看" Foreground="{StaticResource TextPrimary}"
                       FontSize="18" FontWeight="Bold"/>
            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="每一件产品的每个动作节点都记了开始/结束时刻与用时；这里能看「每次同样的动作比上次快还是慢」，也能按工序看整体耗时趋势。"/>
        </StackPanel>

        <!-- 查询条件 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,8">
                        <TextBlock Text="起始日期" Foreground="{StaticResource TextSecond}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding TimingFrom}" Width="140"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,8">
                        <TextBlock Text="截止日期" Foreground="{StaticResource TextSecond}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding TimingTo}" Width="140"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,8">
                        <TextBlock Text="工序" Foreground="{StaticResource TextSecond}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Style="{StaticResource DarkCombo}" Width="190"
                                  ItemsSource="{Binding TimingStepOptions}"
                                  SelectedIndex="{Binding TimingStepFilterIndex}"/>
                    </StackPanel>
                    <CheckBox Content="只看明显偏慢" Foreground="{StaticResource TextPrimary}"
                              IsChecked="{Binding TimingOnlySlow}" VerticalAlignment="Center"
                              Margin="0,0,14,8"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="查询"
                            Command="{Binding QueryTimingCommand}" Margin="0,0,8,8"/>
                    <Button Style="{StaticResource ToolButton}" Content="导出 CSV"
                            Command="{Binding ExportTimingCsvCommand}" Margin="0,0,0,8"/>
                </WrapPanel>

                <TextBlock Text="{Binding TimingSummaryText}" Foreground="{StaticResource TextAccent}"
                           FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 趋势图：某一工序最近若干次用时 -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="动作时间趋势（最近 30 次；虚线 = 平均，点线 = 标准工时）"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Canvas x:Name="TrendCanvas" Height="170" ClipToBounds="True"
                        Background="{StaticResource BgPanelDeep}"/>
            </StackPanel>
        </Border>

        <!-- 工序耗时排行（柏拉图：柱=平均用时，线=累计占比） -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="工序耗时排行（帕累托：柱 = 平均用时，折线 = 累计占比）"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Canvas x:Name="ParetoCanvas" Height="170" ClipToBounds="True"
                        Background="{StaticResource BgPanelDeep}"/>
            </StackPanel>
        </Border>

        <!-- 明细 -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="14,10">
            <TextBlock Text="明细（按完成时刻倒序）" Foreground="{StaticResource TextPrimary}"
                       FontSize="14" FontWeight="SemiBold"/>
        </Border>

        <Border Grid.Row="5" Style="{StaticResource CardBorder}" Margin="0,6,0,0">
            <DataGrid Style="{StaticResource HistoryDataGrid}"
                      ItemsSource="{Binding TimingRecords}"
                      Margin="6"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="完成时刻" Width="150"
                                        Binding="{Binding FinishedAt, StringFormat=yyyy-MM-dd HH:mm:ss}"/>
                    <DataGridTextColumn Header="件号" Width="140" Binding="{Binding PieceId}"/>
                    <DataGridTextColumn Header="工序" Width="170" Binding="{Binding StepName}"/>
                    <DataGridTextColumn Header="用时" Width="80" Binding="{Binding DurationText}"/>
                    <DataGridTextColumn Header="上次" Width="80" Binding="{Binding PreviousText}"/>
                    <DataGridTextColumn Header="标准" Width="80" Binding="{Binding StandardText}"/>
                    <DataGridTextColumn Header="快慢" Width="210" Binding="{Binding PaceText}"/>
                    <DataGridTextColumn Header="判定" Width="70" Binding="{Binding VerdictText}"/>
                    <DataGridTextColumn Header="操作员" Width="90" Binding="{Binding Operator}"/>
                    <DataGridTextColumn Header="批次" Width="110" Binding="{Binding BatchNo}"/>
                    <DataGridTextColumn Header="说明" Width="*" Binding="{Binding Note}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
