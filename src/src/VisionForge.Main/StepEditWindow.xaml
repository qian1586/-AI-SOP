<Window x:Class="VisionForge.Main.StepEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title, FallbackValue=步骤设置}"
        Height="760" Width="660"
        MinHeight="560" MinWidth="600"
        Background="{StaticResource BgWindow}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!--
        步骤设置对话框：右键步骤小方框就弹这个。
        三块内容对应"一步的设置在三个地方"：步骤本身（名称 / 指引 / 超时 / 锁线）、
        画面上的框（位置与大小）、检测参数（算法阈值）。三块一起改、一起存。
    -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title, FallbackValue=步骤设置}"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="18" FontWeight="Bold"/>
            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="改完点「确定」立即生效并保存。步骤名称会同时写到画面上对应的那个框上（第 N 步 ↔ 第 N 个框）。"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ============ ① 步骤本身 ============ -->
                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="① 步骤" Foreground="{StaticResource TextPrimary}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="步骤名称" Foreground="{StaticResource TextSecond}"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource DarkInput}"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="例：取件并放入工装。这个名字会同时显示在步骤小方框和画面的框上"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="作业指引" Foreground="{StaticResource TextSecond}"
                                       FontSize="12" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <TextBox Grid.Column="1" Style="{StaticResource DarkInput}"
                                     Text="{Binding Hint, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52"
                                     ToolTip="给现场员工看的一句话，显示在首页的「当前步骤」里"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="允许耗时" Foreground="{StaticResource TextSecond}"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Style="{StaticResource DarkInput}" Width="90"
                                     Text="{Binding TimeoutSec, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="单位秒。超时会提示「这一步超时」，默认不锁线。填 0 = 不检查超时"/>
                            <TextBlock Grid.Column="2" Text="秒（0 = 不检查超时）"
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <CheckBox Content="这一步不合格时锁线（关键工序勾上；辅助工序不勾，只告警放行）"
                                  Foreground="{StaticResource TextPrimary}"
                                  IsChecked="{Binding BlockNextOnFail}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ============ ② 画面上的框 ============ -->
                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="② 这一步对应的画面区域" Foreground="{StaticResource TextPrimary}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding RoiLabel}"
                                   Foreground="{StaticResource TextAccent}" FontSize="12" Margin="0,0,0,8"/>

                        <!-- 没有对应框时给一条明确的指引，而不是让用户对着空表格发呆 -->
                        <Border Background="{StaticResource BgPanelDeep}" CornerRadius="4" Padding="10,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRoi}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding RoiMissingHint}"
                                       Foreground="{StaticResource StateWarn}"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRoi}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Foreground="{StaticResource TextSecond}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="下面四个数是「占画面的百分之几」，改完直接生效。想更直观就点下面的按钮，回首页用鼠标重新框。"/>
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,8">
                                    <TextBlock Text="左边" Foreground="{StaticResource TextSecond}"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Style="{StaticResource DarkInput}" Width="74"
                                             Text="{Binding RoiLeftPercent, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="%" Foreground="{StaticResource TextMuted}"
                                               FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,8">
                                    <TextBlock Text="上边" Foreground="{StaticResource TextSecond}"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Style="{StaticResource DarkInput}" Width="74"
                                             Text="{Binding RoiTopPercent, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="%" Foreground="{StaticResource TextMuted}"
                                               FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,8">
                                    <TextBlock Text="宽" Foreground="{StaticResource TextSecond}"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Style="{StaticResource DarkInput}" Width="74"
                                             Text="{Binding RoiWidthPercent, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="%" Foreground="{StaticResource TextMuted}"
                                               FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="高" Foreground="{StaticResource TextSecond}"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Style="{StaticResource DarkInput}" Width="74"
                                             Text="{Binding RoiHeightPercent, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="%" Foreground="{StaticResource TextMuted}"
                                               FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </WrapPanel>

                            <Button Style="{StaticResource ToolButton}" Content="🎯 到首页用鼠标重新框这一步"
                                    HorizontalAlignment="Left" Margin="0"
                                    Click="OnReframe"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ ③ 检测参数 ============ -->
                <Border Style="{StaticResource CardBorder}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="③ 检测参数" Foreground="{StaticResource TextPrimary}"
                                   FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,4,0,10">
                            <Run Text="算法："/>
                            <Run Text="{Binding AlgorithmName, Mode=OneWay}"
                                 Foreground="{StaticResource TextAccent}" FontWeight="SemiBold"/>
                            <Run Text="　（配方级参数：同一个配方的所有步骤共用，改了对整条线生效）"/>
                        </TextBlock>

                        <TextBlock Text="这个配方没有可调参数（或没有绑定算法）"
                                   Foreground="{StaticResource TextSecond}" FontSize="12" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasParameters}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Parameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{StaticResource TextSecond}"
                                                       FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding RangeHint}"
                                                       Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                        </StackPanel>
                                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkInput}"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{Binding Description}"/>

                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                                    Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}">
                                            <ToggleButton x:Name="StepParamHint" Style="{StaticResource HintToggle}"/>
                                            <Border Background="{StaticResource BgPanelDeep}" CornerRadius="4"
                                                    Padding="8,6" Margin="0,4,0,0"
                                                    Visibility="{Binding IsChecked, ElementName=StepParamHint, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="{StaticResource TextSecond}"
                                                           FontSize="12" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 校验错误：不弹窗，直接贴在按钮上方 -->
        <Border Grid.Row="2" Background="#33EF4444" CornerRadius="4" Padding="10,6" Margin="0,12,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource StateNg}"
                       FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource ToolButton}" Content="取消"
                    Click="OnCancel" Margin="0,0,8,0" MinWidth="90"/>
            <Button Style="{StaticResource PrimaryButton}" Content="确定"
                    Click="OnConfirm" MinWidth="110"/>
        </StackPanel>
    </Grid>
</Window>
