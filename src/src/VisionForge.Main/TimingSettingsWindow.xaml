<Window x:Class="VisionForge.Main.TimingSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="时间设置 · 标准工时"
        Height="720" Width="640"
        MinHeight="520" MinWidth="560"
        Background="{StaticResource BgWindow}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!--
        「时间设置」窗口：定每道工序的标准工时，以及记录策略。
        标准工时是"快还是慢"的基准 —— 没有它，新员工上手时只能跟自己的上一次比，
        看不出"这个工位整体就偏慢"。
    -->
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="时间设置" Foreground="{StaticResource TextPrimary}"
                       FontSize="18" FontWeight="Bold"/>
            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11"
                       TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="动作计时记录每一步的开始/结束时刻与用时；标准工时用来判断「这次比正常快还是慢」。填 0 = 这道工序不做快慢对比。"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="记录策略" Foreground="{StaticResource TextPrimary}"
                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <CheckBox Content="记录动作计时（关掉就完全不落盘）"
                          Foreground="{StaticResource TextPrimary}"
                          IsChecked="{Binding Enabled}" Margin="0,0,0,8"/>
                <CheckBox Content="NG 的那一次也记录（复盘「为什么这一下花了这么久」时有用）"
                          Foreground="{StaticResource TextPrimary}"
                          IsChecked="{Binding RecordNg}" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="慢多少算「明显偏慢」" Foreground="{StaticResource TextSecond}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Style="{StaticResource DarkInput}" Width="70"
                             Text="{Binding SlowAlertPercent, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="%（超过就标红，默认 30%）" Foreground="{StaticResource TextMuted}"
                               FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="各工序标准工时（秒）"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource TextMuted}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="工序来自画面上的框（第 N 个框 = 第 N 道工序）。现场常用做法：让熟练工连做 5 件取平均，填进去。"/>

                <TextBlock DockPanel.Dock="Bottom" Foreground="{StaticResource TextMuted}"
                           FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="{Binding DataFolder, StringFormat=计时数据保存位置：{0}}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource DarkInput}" Width="90"
                                             Text="{Binding StandardSec, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" Text="秒" Foreground="{StaticResource TextMuted}"
                                               FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Background="#33EF4444" CornerRadius="4" Padding="10,6" Margin="0,12,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource StateNg}"
                       FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource ToolButton}" Content="取消"
                    Click="OnCancel" Margin="0,0,8,0" MinWidth="90"/>
            <Button Style="{StaticResource PrimaryButton}" Content="保存"
                    Click="OnConfirm" MinWidth="110"/>
        </StackPanel>
    </Grid>
</Window>
