<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VisionForge.Core\VisionForge.Core.csproj" />
    <ProjectReference Include="..\VisionForge.Hardware\VisionForge.Hardware.csproj" />
    <ProjectReference Include="..\VisionForge.Infrastructure\VisionForge.Infrastructure.csproj" />
    <ProjectReference Include="..\VisionForge.Common\VisionForge.Common.csproj" />
  </ItemGroup>

  <!--
    品牌资源编译进程序集（而不是放在 exe 旁边）：
    现场拷贝程序时不会漏文件，也就不会出现"logo 变成空白方块"。
    源图是白底黑字的截图，这里用的是处理过的版本：浅底已抠透明、黑字改白字、
    金色笔触保留 —— 否则黑字贴在深色界面上根本看不见。
  -->
  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo-icon.png" />
    <Resource Include="Assets\logo.ico" />
  </ItemGroup>

  <!--
    一段 3 秒的极小测试录像（15KB，H.264）。
    用途只有一个：自检里真的把"录像当相机"打开一次，验证 播放 / 暂停 / 重播 真的有效 ——
    现场反馈过"导入录像后暂停不了"，而这种问题不真开一次文件是查不出来的。
  -->
  <ItemGroup>
    <Content Include="Assets\test-clip.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    手部关键点：ONNX Runtime + 模型。

    刻意**不用 NuGet 包**，而是直接引用 src\lib\onnxruntime 下的两个 DLL：
      1. onnxruntime 的 NuGet 包有 108MB（装着所有平台的原生库），我们只要 Windows x64 的 11.6MB；
      2. 现场重建时不必再联网拉包 —— 有几次车间网络是连不上 nuget.org 的。
    原生 DLL 必须落到 exe 同级目录（CopyToOutputDirectory），否则运行时报找不到 onnxruntime。
  -->
  <ItemGroup>
    <Reference Include="Microsoft.ML.OnnxRuntime">
      <HintPath>..\..\lib\onnxruntime\Microsoft.ML.OnnxRuntime.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\lib\onnxruntime\onnxruntime.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\lib\onnxruntime\onnxruntime_providers_shared.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\models\hand_pose.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\pose-test.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!--
      exe 的图标。写在这里才会被嵌进 VisionForge.Main.exe 的 Win32 资源里 ——
      桌面快捷方式、任务栏、资源管理器里显示的都是它。
      （只在 XAML 里设 Window.Icon 是不够的：那只管窗口标题栏，
       快捷方式和任务栏仍是 exe 的默认图标。）
    -->
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
