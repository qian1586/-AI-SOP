<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VisionForge.Core\VisionForge.Core.csproj" />
    <ProjectReference Include="..\VisionForge.Hardware\VisionForge.Hardware.csproj" />
    <ProjectReference Include="..\VisionForge.Infrastructure\VisionForge.Infrastructure.csproj" />
    <ProjectReference Include="..\VisionForge.Common\VisionForge.Common.csproj" />
  </ItemGroup>

  <!--
    品牌资源编译进程序集（而不是放在 exe 旁边）：
    现场拷贝程序时不会漏文件，也就不会出现"logo 变成空白方块"。
    源图是白底黑字的截图，这里用的是处理过的版本：浅底已抠透明、黑字改白字、
    金色笔触保留 —— 否则黑字贴在深色界面上根本看不见。
  -->
  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo-icon.png" />
    <Resource Include="Assets\logo.ico" />
  </ItemGroup>

  <!--
    一段 3 秒的极小测试录像（15KB，H.264）。
    用途只有一个：自检里真的把"录像当相机"打开一次，验证 播放 / 暂停 / 重播 真的有效 ——
    现场反馈过"导入录像后暂停不了"，而这种问题不真开一次文件是查不出来的。
  -->
  <ItemGroup>
    <Content Include="Assets\test-clip.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!--
      exe 的图标。写在这里才会被嵌进 VisionForge.Main.exe 的 Win32 资源里 ——
      桌面快捷方式、任务栏、资源管理器里显示的都是它。
      （只在 XAML 里设 Window.Icon 是不够的：那只管窗口标题栏，
       快捷方式和任务栏仍是 exe 的默认图标。）
    -->
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
