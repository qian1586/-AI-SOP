<Window x:Class="VisionForge.Main.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="权限校验"
        Height="300" Width="470"
        MinHeight="300" MinWidth="470"
        ResizeMode="NoResize"
        Background="{StaticResource BgWindow}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!--
        切换角色时的口令窗口。

        只做一件事：让想升级权限的人证明自己是那个人。
        故意做得很小 —— 现场操作员点开它时不该看到任何多余信息。
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="🔒" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="TitleText" Text="切换到「工程师」需要口令"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="RoleHintText"
                   Foreground="{StaticResource TextSecond}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="全部权限：配方增删改、标定、放行、系统设置"/>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="口令" Foreground="{StaticResource TextSecond}" FontSize="12" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PasswordInput"
                         Height="34" Padding="8,4"
                         Background="{StaticResource BgPanelDeep}"
                         Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderSoft}"
                         BorderThickness="1"
                         CaretBrush="{StaticResource TextAccent}"
                         FontSize="14"
                         KeyDown="OnPasswordKeyDown"
                         ToolTip="输入该角色的口令后回车即可"/>
        </StackPanel>

        <TextBlock Grid.Row="3" x:Name="ErrorText"
                   Foreground="{StaticResource StateNg}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="DefaultPasswordHint"
                       Foreground="{StaticResource StateWarn}"
                       FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"
                       Visibility="Collapsed"
                       Text="出厂默认口令，请在「系统设置」里改掉"/>
            <Button Style="{StaticResource ToolButton}" Content="取消"
                    IsCancel="True" Padding="16,6" Margin="0,0,8,0"
                    Click="OnCancel"/>
            <Button Style="{StaticResource PrimaryButton}" Content="确定"
                    IsDefault="True" Padding="16,6"
                    Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>
