<?xml version="1.0" encoding="utf-8"?>
<!--
  本解决方案刻意做到「零 NuGet 依赖」：
    · MVVM 基础类、事件聚合器 —— 自研（Common 层）
    · 图像数据结构 —— 自定义 CameraFrame，不引 OpenCV
    · Modbus TCP —— 自研协议实现，不引 NModbus
    · JSON —— 用 .NET 内置 System.Text.Json，不引 Newtonsoft
    · 日志 / 存储 —— 自研，不引 Serilog / SQLite 包

  这样做的好处（也是给现场部署省事）：
    1. 离线可编译，厂区内网机器不用配 NuGet 源
    2. 没有第三方包版本冲突和漏洞升级压力
    3. 出问题时排查范围可控 —— 全栈代码都在自己手里

  如果将来确实需要引入包（比如 OpenCVSharp、NModbus），
  把下面的 <clear /> 去掉并加回 nuget.org 源即可。
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>

  <config>
    <add key="globalPackagesFolder"
         value=".nuget\packages" />
  </config>
</configuration>
